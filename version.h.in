#ifndef VERSION_H
#define VERSION_H

#ifndef APP_VERSION
// Полная версия из файла VERSION: у черновых сборок она с суффиксом (1.4.3-rc1),
// а CMAKE_PROJECT_VERSION хранит только числовую часть — CMake иначе не собирает.
#define APP_VERSION "@COTTON_FULL_VERSION@"
#endif

#ifndef APP_MAJOR_VERSION
#define APP_MAJOR_VERSION "@APP_MAJOR_VERSION@"
#endif

#define APPLICATION_NAME    "CottonVPN"
#define SERVICE_NAME        "CottonVPN-service"
#define ORGANIZATION_NAME   "CottonVPN"

#endif  // VERSION_H
